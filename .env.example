# ============================================================================
# BiBuru · variables de entorno. Copia este archivo a `.env.local` y rellénalo.
# En Vercel se ponen en Settings → Environment Variables (ver README).
# NUNCA subas `.env.local` al repositorio.
# ============================================================================

# --- Supabase (Fase 1) -------------------------------------------------------
# Supabase → Project Settings → API Keys (o "Data API").
# URL del proyecto, p. ej. https://abcdefgh.supabase.co  (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Clave "publishable" (empieza por sb_publishable_...). Pública por diseño:
# la seguridad la da Row Level Security. (Si tu proyecto solo tiene la clave
# antigua "anon", pégala en NEXT_PUBLIC_SUPABASE_ANON_KEY; también funciona.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Acceso (Fase 1) ---------------------------------------------------------
# Correos que pueden entrar, separados por comas. Vacío = no entra nadie.
ALLOWED_EMAILS=
# Registro abierto por defecto: cualquiera puede crear cuenta (cada uno con su propio espacio).
# Pon OPEN_SIGNUP=false para cerrarlo: entonces solo entran los correos de ALLOWED_EMAILS.
# OPEN_SIGNUP=false

# --- Avisos y tareas programadas (Fase 5) -----------------------------------
# Claves VAPID: genera con `npm run vapid` y pega las tres líneas. La pública va al navegador; la privada es secreta.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
# Secreto que protege /api/cron/*. Invéntalo largo y aleatorio (mín. 20 caracteres), p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Clave SECRETA de Supabase (Project Settings → API Keys → secret / service_role). Solo servidor; la usa el cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (Fase 6) -------------------------------------------------------------
# Clave de Google AI Studio (aistudio.google.com → Get API key). Solo servidor. Sin ella, la IA queda desactivada.
GEMINI_API_KEY=
# Modelos configurables (si Google cambia nombres, se cambia aquí sin tocar código).
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_VIDEO=gemini-3.8-flash
# Límite de peticiones a la IA por minuto (plan gratuito: no pases de 10-15).
AI_MAX_RPM=10

# --- Favoritos y YouTube (Fase 7) --------------------------------------------
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web). Ver README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: URI de retorno exacta registrada en Google (por defecto https://TU-DOMINIO/api/google/callback).
# GOOGLE_REDIRECT_URI=
# Clave para cifrar los tokens de Google, Microsoft, Instagram y TikTok (AES-256). Genérala así y no la pierdas ni la cambies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Solo pruebas locales con un Gemini falso; en producción NO se define.
# GEMINI_BASE_URL=

# --- Correo de Outlook (Microsoft Graph, solo lectura) ----------------------
# entra.microsoft.com → Registros de aplicaciones → Nuevo registro (cuentas de cualquier organización y personales).
# URI de redirección (Web): https://TU-DOMINIO/api/outlook/callback. Permisos delegados: Mail.Read, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Opcional: si la URI registrada no es la de por defecto.
# MICROSOFT_REDIRECT_URI=

# --- Instagram de negocio (API de Instagram con inicio de sesión de Instagram) -
# developers.facebook.com → tu app → Instagram → «API setup with Instagram login». OJO: el ID y la clave «de Instagram», no los de Facebook.
# URI de redirección: https://TU-DOMINIO/api/instagram/callback. En modo desarrollo, añade tu cuenta como «Instagram tester».
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcionales:
# INSTAGRAM_REDIRECT_URI=
# INSTAGRAM_API_VERSION=v23.0

# --- TikTok de negocio (Login Kit + Display API + Content Posting API) ------
# developers.tiktok.com → Manage apps → tu app (o su Sandbox). URI de redirección: https://TU-DOMINIO/api/tiktok/callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Solo cuando TikTok haya auditado la app para «Direct Post» (si no, lo publicado por API queda privado): 1
# TIKTOK_DIRECT_POST_AUDITED=1
# TIKTOK_REDIRECT_URI=

# --- Política de privacidad (/privacidad) ------------------------------------
# Correo de contacto que se muestra en la página (opcional).
# PRIVACY_CONTACT_EMAIL=

# --- Importación de PROFITY (solo en TU ordenador, en .env.local; NUNCA en Vercel) ---
# Cadena de conexión de la base de PROFITY (Neon → Connection string).
# PROFITY_DATABASE_URL=
# Clave secreta de Supabase (service_role / secret). Da acceso total: no la compartas ni la subas.
# SUPABASE_SERVICE_ROLE_KEY=
